# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Custom Authentication (JWT + Bcrypt)
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-random-secret
JWT_REFRESH_SECRET=replace-with-another-32-characters-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
COOKIE_SECURE=false

# Demo & Automated Workflow Controls
DEMO_TIME_SCALE=1
CRON_SECRET=civicmind-cron-secret-super-secure-key-2026
DEMO_PASSWORD=DemoPassword123!

# Supabase (Server only - managed PostgreSQL & private Storage via service role key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=issue-images
# Optional direct Postgres DB connection string for migrations/scripts
DATABASE_URL=

# Gemini AI (Server only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CONCURRENCY=3

# Pipeline tuning
DUPLICATE_RADIUS_M=75
DUPLICATE_LOOKBACK_DAYS=30
DUPLICATE_MAX_CANDIDATES=5
DUPLICATE_MERGE_MIN_SIMILARITY=0.6
AI_CONFIDENCE_THRESHOLD=0.55
MAX_REPORTS_PER_USER_PER_DAY=15

# Simulated workflow
WORKFLOW_ENABLED=true
WORKFLOW_TICK_CRON=* * * * *
DEPARTMENT_API_URL=

# Email (optional)
EMAIL_ADAPTER=console
RESEND_API_KEY=
EMAIL_FROM=CivicMind <noreply@example.com>

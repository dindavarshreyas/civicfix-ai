# ==============================================================================
# CivicMind: Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Files (NEVER push secrets to Git)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
server/.env
server/.env.*
client/.env
client/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Private keys, certificates & credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.asc
keys.txt
secrets/
credentials.json
service-account*.json
token.json

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp/
.pnp.js
.pnp.*

# Yarn
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity

# ------------------------------------------------------------------------------
# 3. Production Builds & Compiled Assets
# ------------------------------------------------------------------------------
dist/
*/dist/
build/
*/build/
out/
*/out/
.output/
*.tsbuildinfo

# Vite, Turbo & Build tool caches
.vite/
*/.vite/
.turbo/
.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# 4. Testing, Code Coverage & Tooling Caches
# ------------------------------------------------------------------------------
coverage/
*/coverage/
*.lcov
.nyc_output/
.vitest/
*/.vitest/
test-results/
playwright-report/
blob-report/
.eslintcache
.stylelintcache
.prettiercache

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pino-*.log
report.[0-9]*.json
core.[0-9]*

# ------------------------------------------------------------------------------
# 6. IDE, Code Editors & Workspaces
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains / IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Visual Studio / Windows Dev Tools
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 8. Temporary Files & Local Storage
# ------------------------------------------------------------------------------
tmp/
temp/
.tmp/
.temp/
scratch/
uploads/
*/uploads/
downloads/
